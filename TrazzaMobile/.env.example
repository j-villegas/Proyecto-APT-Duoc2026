EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: key solo para el mapa de la versión web (restringida a sitios web,
# p. ej. http://localhost:8081/*). Si falta, se usa la de arriba.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# true = muestra el interruptor "Modo demostración" (GPS simulado) en la ruta activa del conductor.
# En desarrollo (__DEV__) aparece siempre.
EXPO_PUBLIC_DEMO_MODE=
# Duración del recorrido simulado en minutos (por defecto 3).
EXPO_PUBLIC_DEMO_SIM_MINUTES=

# Solo para scripts/migraciones locales (Supabase CLI). No se usa en la app.
DATABASE_URL=
