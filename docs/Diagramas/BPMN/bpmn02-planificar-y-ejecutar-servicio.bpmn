<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_bpmn02-planificar-y-ejecutar-servicio" targetNamespace="http://trazza.cl/bpmn">
  <bpmn:collaboration id="Collab_bpmn02-planificar-y-ejecutar-servicio">
    <bpmn:participant id="Part_pyme" name="Pyme de transporte (Administración operacional)" processRef="Proc_pyme" />
    <bpmn:participant id="Part_con" name="Conductor / operación" processRef="Proc_con" />
    <bpmn:participant id="Part_sis" name="TRAZZA / sistema" processRef="Proc_sis" />
    <bpmn:participant id="Part_pas" name="Pasajero" processRef="Proc_pas" />
    <bpmn:messageFlow id="Msg_bpmn02-planificar-y-ejecutar-servicio_0" sourceRef="a_t3" targetRef="d_s" name="Servicio asignado" />
    <bpmn:messageFlow id="Msg_bpmn02-planificar-y-ejecutar-servicio_1" sourceRef="d_e" targetRef="s_s1" name="Cierre" />
    <bpmn:messageFlow id="Msg_bpmn02-planificar-y-ejecutar-servicio_2" sourceRef="d_t2" targetRef="s_s2" name="Estado / ubicación" />
    <bpmn:messageFlow id="Msg_bpmn02-planificar-y-ejecutar-servicio_3" sourceRef="s_t2" targetRef="x_t" name="Consulta" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_pyme" isExecutable="false">
    <bpmn:startEvent id="a_s" name="Necesidad de viaje" />
    <bpmn:task id="a_t1" name="Definir ruta, fecha y pasajeros" />
    <bpmn:task id="a_t2" name="Validar recursos" />
    <bpmn:exclusiveGateway id="a_g" name="¿Recursos disponibles?" />
    <bpmn:task id="a_t3" name="Programar y asignar" />
    <bpmn:task id="a_t4" name="Reprogramar o cancelar" />
    <bpmn:exclusiveGateway id="a_g2" name="¿Reprogramar?" />
    <bpmn:endEvent id="a_e" name="Cancelado" />
    <bpmn:sequenceFlow id="Flow_pyme_0" sourceRef="a_s" targetRef="a_t1" />
    <bpmn:sequenceFlow id="Flow_pyme_1" sourceRef="a_t1" targetRef="a_t2" />
    <bpmn:sequenceFlow id="Flow_pyme_2" sourceRef="a_t2" targetRef="a_g" />
    <bpmn:sequenceFlow id="Flow_pyme_3" sourceRef="a_g" targetRef="a_t3" name="Disponibles" />
    <bpmn:sequenceFlow id="Flow_pyme_4" sourceRef="a_g" targetRef="a_t4" name="No disponibles" />
    <bpmn:sequenceFlow id="Flow_pyme_5" sourceRef="a_t4" targetRef="a_g2" />
    <bpmn:sequenceFlow id="Flow_pyme_6" sourceRef="a_g2" targetRef="a_e" name="Cancelar" />
    <bpmn:sequenceFlow id="Flow_pyme_7" sourceRef="a_g2" targetRef="a_t1" name="Reprogramar" />
  </bpmn:process>
  <bpmn:process id="Proc_con" isExecutable="false">
    <bpmn:startEvent id="d_s" name="Servicio asignado"><bpmn:messageEventDefinition id="d_s_d" /></bpmn:startEvent>
    <bpmn:task id="d_t1" name="Iniciar servicio" />
    <bpmn:task id="d_t2" name="Transportar y registrar asistencia y GPS" />
    <bpmn:task id="d_t3" name="Finalizar servicio" />
    <bpmn:endEvent id="d_e" name="Servicio finalizado"><bpmn:messageEventDefinition id="d_e_d" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_con_0" sourceRef="d_s" targetRef="d_t1" />
    <bpmn:sequenceFlow id="Flow_con_1" sourceRef="d_t1" targetRef="d_t2" />
    <bpmn:sequenceFlow id="Flow_con_2" sourceRef="d_t2" targetRef="d_t3" />
    <bpmn:sequenceFlow id="Flow_con_3" sourceRef="d_t3" targetRef="d_e" />
  </bpmn:process>
  <bpmn:process id="Proc_sis" isExecutable="false">
    <bpmn:startEvent id="s_s1" name="Servicio finalizado"><bpmn:messageEventDefinition id="s_s1_d" /></bpmn:startEvent>
    <bpmn:task id="s_t1" name="Guardar término y liberar recursos" />
    <bpmn:endEvent id="s_e1" name="Completado" />
    <bpmn:startEvent id="s_s2" name="Estado de viaje recibido"><bpmn:messageEventDefinition id="s_s2_d" /></bpmn:startEvent>
    <bpmn:task id="s_t2" name="Exponer estado y ubicación autorizados" />
    <bpmn:endEvent id="s_e2" name="Estado publicado" />
    <bpmn:sequenceFlow id="Flow_sis_0" sourceRef="s_s1" targetRef="s_t1" />
    <bpmn:sequenceFlow id="Flow_sis_1" sourceRef="s_t1" targetRef="s_e1" />
    <bpmn:sequenceFlow id="Flow_sis_2" sourceRef="s_s2" targetRef="s_t2" />
    <bpmn:sequenceFlow id="Flow_sis_3" sourceRef="s_t2" targetRef="s_e2" />
  </bpmn:process>
  <bpmn:process id="Proc_pas" isExecutable="false">
    <bpmn:startEvent id="x_s" name="Quiere ver su viaje" />
    <bpmn:task id="x_t" name="Consultar viaje autorizado" />
    <bpmn:endEvent id="x_e" name="Consulta atendida" />
    <bpmn:sequenceFlow id="Flow_pas_0" sourceRef="x_s" targetRef="x_t" />
    <bpmn:sequenceFlow id="Flow_pas_1" sourceRef="x_t" targetRef="x_e" />
  </bpmn:process>
