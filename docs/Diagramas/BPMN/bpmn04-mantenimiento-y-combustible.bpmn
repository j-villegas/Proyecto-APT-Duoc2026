      <bpmndi:BPMNShape id="f_e_di" bpmnElement="f_e" bioc:stroke="#f5a524" bioc:fill="#2b2114"><dc:Bounds x="752.0" y="276.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="711.0" y="316.0" width="118" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
