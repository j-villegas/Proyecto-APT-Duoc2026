<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_bpmn04-mantenimiento-y-combustible" targetNamespace="http://trazza.cl/bpmn">
  <bpmn:collaboration id="Collab_bpmn04-mantenimiento-y-combustible">
    <bpmn:participant id="Part_fl" name="Pyme de transporte (Responsable de flota)" processRef="Proc_fl" />
    <bpmn:participant id="Part_sis" name="TRAZZA / sistema" processRef="Proc_sis" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_fl" isExecutable="false">
    <bpmn:startEvent id="m_s" name="Necesidad de mantenimiento" />
    <bpmn:task id="m_t1" name="Planificar mantenimiento" />
    <bpmn:task id="m_t2" name="Ejecutar intervención y registrar cierre" />
    <bpmn:task id="m_t3" name="Actualizar disponibilidad" />
    <bpmn:endEvent id="m_e" name="Vehículo habilitado" />
    <bpmn:sequenceFlow id="Flow_fl_0" sourceRef="m_s" targetRef="m_t1" />
    <bpmn:sequenceFlow id="Flow_fl_1" sourceRef="m_t1" targetRef="m_t2" />
    <bpmn:sequenceFlow id="Flow_fl_2" sourceRef="m_t2" targetRef="m_t3" />
    <bpmn:sequenceFlow id="Flow_fl_3" sourceRef="m_t3" targetRef="m_e" />
  </bpmn:process>
  <bpmn:process id="Proc_sis" isExecutable="false">
    <bpmn:startEvent id="f_s" name="Carga de combustible" />
    <bpmn:task id="f_t1" name="Capturar comprobante y datos de carga" />
    <bpmn:task id="f_t2" name="Validar y guardar registro" />
    <bpmn:task id="f_t3" name="Actualizar kilometraje si corresponde" />
    <bpmn:endEvent id="f_e" name="Carga registrada" />
    <bpmn:sequenceFlow id="Flow_sis_0" sourceRef="f_s" targetRef="f_t1" />
    <bpmn:sequenceFlow id="Flow_sis_1" sourceRef="f_t1" targetRef="f_t2" />
    <bpmn:sequenceFlow id="Flow_sis_2" sourceRef="f_t2" targetRef="f_t3" />
    <bpmn:sequenceFlow id="Flow_sis_3" sourceRef="f_t3" targetRef="f_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_bpmn04-mantenimiento-y-combustible">
    <bpmndi:BPMNPlane id="Plane_bpmn04-mantenimiento-y-combustible" bpmnElement="Collab_bpmn04-mantenimiento-y-combustible">
