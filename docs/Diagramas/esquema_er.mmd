erDiagram
    %% ============================================================
    %% Esquema public - Diagrama ER
    %% Cardinalidad:  ||--o{  FK obligatoria (NOT NULL)
    %%                |o--o{  FK opcional (nullable)
    %% Tipos abreviados: timestamptz = timestamp with time zone
    %%                   time        = time without time zone
    %%                   *_array     = ARRAY
    %% ============================================================

    %% ---------- Relaciones: núcleo / tenancy ----------
    auth_users ||--|| profiles : "id"
    companies ||--o{ profiles : "company_id"
    companies ||--o{ contracts : "company_id"
    companies ||--o{ drivers : "company_id"
    companies ||--o{ passengers : "company_id"
    companies ||--o{ vehicles : "company_id"
    companies ||--o{ routes : "company_id"
    companies ||--o{ route_stops : "company_id"
    companies ||--o{ route_passengers : "company_id"
    companies ||--o{ route_schedules : "company_id"
    companies ||--o{ services : "company_id"
    companies ||--o{ service_stops : "company_id"
    companies ||--o{ service_passengers : "company_id"
    companies ||--o{ service_locations : "company_id"
    companies ||--o{ service_events : "company_id"
    companies ||--o{ incident_types : "company_id"
    companies ||--o{ incidents : "company_id"
    companies ||--o{ fuel_logs : "company_id"
    companies ||--o{ maintenance_orders : "company_id"
    companies ||--o{ operational_alerts : "company_id"
    companies ||--o{ passenger_service_access : "company_id"
    companies ||--o{ contract_passengers : "company_id"
    companies |o--o{ audit_logs : "company_id"

    %% ---------- Relaciones: personas ----------
    profiles |o--o{ drivers : "profile_id"
    profiles |o--o{ passengers : "profile_id"

    %% ---------- Relaciones: contratos y rutas ----------
    contracts |o--o{ routes : "contract_id"
    contracts ||--o{ contract_passengers : "contract_id"
    passengers ||--o{ contract_passengers : "passenger_id"
    routes ||--o{ route_stops : "route_id"
    routes ||--o{ route_schedules : "route_id"
    routes ||--o{ route_passengers : "route_id"
    route_stops |o--o{ route_passengers : "route_stop_id"
    passengers ||--o{ route_passengers : "passenger_id"

    %% ---------- Relaciones: servicios ----------
    contracts |o--o{ services : "contract_id"
    routes |o--o{ services : "route_id"
    drivers |o--o{ services : "driver_id"
    vehicles |o--o{ services : "vehicle_id"
    profiles |o--o{ services : "finalized_by_profile_id"
    services ||--o{ service_stops : "service_id"
    route_stops |o--o{ service_stops : "route_stop_id"
    services ||--o{ service_passengers : "service_id"
    service_stops |o--o{ service_passengers : "service_stop_id"
    passengers ||--o{ service_passengers : "passenger_id"
    route_passengers |o--o{ service_passengers : "route_passenger_id"
    drivers |o--o{ service_passengers : "marked_by_driver_id"
    profiles |o--o{ service_passengers : "marked_by_profile_id"
    services ||--o{ service_locations : "service_id"
    drivers |o--o{ service_locations : "driver_id"
    vehicles |o--o{ service_locations : "vehicle_id"
    services ||--o{ service_events : "service_id"
    services ||--o{ passenger_service_access : "service_id"
    passengers ||--o{ passenger_service_access : "passenger_id"
    service_passengers |o--o{ passenger_service_access : "service_passenger_id"

    %% ---------- Relaciones: incidentes ----------
    incident_types |o--o{ incidents : "incident_type_id"
    services |o--o{ incidents : "service_id"
    routes |o--o{ incidents : "route_id"
    vehicles |o--o{ incidents : "vehicle_id"
    drivers |o--o{ incidents : "driver_id"
    passengers |o--o{ incidents : "passenger_id"
    service_stops |o--o{ incidents : "service_stop_id"
    profiles |o--o{ incidents : "reported_by_profile_id"
    drivers |o--o{ incidents : "reported_by_driver_id"
    passengers |o--o{ incidents : "reported_by_passenger_id"

    %% ---------- Relaciones: combustible y mantención ----------
    vehicles ||--o{ fuel_logs : "vehicle_id"
    services |o--o{ fuel_logs : "service_id"
    drivers |o--o{ fuel_logs : "driver_id"
    profiles |o--o{ fuel_logs : "created_by_profile_id"
    vehicles ||--o{ maintenance_orders : "vehicle_id"
    incidents |o--o{ maintenance_orders : "incident_id"
    profiles |o--o{ maintenance_orders : "created_by_profile_id"

    %% ============================================================
    %% Entidades
    %% ============================================================

    auth_users {
        uuid id PK
    }

    companies {
        uuid id PK
        text name
        text rut
        text business_name
        text contact_email
        text contact_phone
        text address
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    profiles {
        uuid id PK, FK
        uuid company_id FK
        text full_name
        text email
        text phone
        text role
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    contracts {
        uuid id PK
        uuid company_id FK
        text client_name
        text contract_name
        date start_date
        date end_date
        text notes
        text status
        text priority
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    drivers {
        uuid id PK
        uuid company_id FK
        uuid profile_id FK
        text driver_code
        text full_name
        text rut
        text phone
        text email
        text license_type
        text license_number
        date license_expires_at
        text notes
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    passengers {
        uuid id PK
        uuid profile_id FK
        uuid company_id FK
        text full_name
        text rut
        text phone
        text email
        text notes
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    vehicles {
        uuid id PK
        uuid company_id FK
        text plate
        text brand
        text model
        text vehicle_type
        integer year
        integer capacity_passengers
        numeric current_odometer_km
        numeric next_maintenance_km
        numeric estimated_fuel_efficiency_km_l
        text fuel_type
        numeric tank_capacity_liters
        text base_location
        date technical_review_expires_at
        date circulation_permit_expires_at
        date insurance_expires_at
        text insurance_policy_number
        text notes
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    routes {
        uuid id PK
        uuid company_id FK
        uuid contract_id FK
        text route_code
        text name
        text origin_name
        text origin_address
        numeric origin_latitude
        numeric origin_longitude
        text destination_name
        text destination_address
        numeric destination_latitude
        numeric destination_longitude
        integer estimated_duration_minutes
        numeric estimated_distance_km
        text notes
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    route_stops {
        uuid id PK
        uuid company_id FK
        uuid route_id FK
        integer stop_order
        text name
        text address
        numeric latitude
        numeric longitude
        time planned_time
        text notes
        text stop_type
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    route_passengers {
        uuid id PK
        uuid company_id FK
        uuid route_id FK
        uuid route_stop_id FK
        uuid passenger_id FK
        text notes
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    route_schedules {
        uuid id PK
        uuid company_id FK
        uuid route_id FK
        text name
        time start_time
        time end_time
        date valid_from
        date valid_until
        text notes
        integer_array days_of_week
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    services {
        uuid id PK
        uuid company_id FK
        uuid contract_id FK
        uuid route_id FK
        text service_code
        date scheduled_date
        time scheduled_start_time
        time scheduled_end_time
        timestamptz actual_start_at
        timestamptz actual_end_at
        uuid driver_id FK
        uuid vehicle_id FK
        text completion_source
        uuid finalized_by_profile_id FK
        text cancel_reason
        text notes
        text status
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    service_stops {
        uuid id PK
        uuid company_id FK
        uuid service_id FK
        uuid route_stop_id FK
        integer stop_order
        text name
        text address
        numeric latitude
        numeric longitude
        time planned_arrival_time
        timestamptz actual_arrival_at
        timestamptz completed_at
        text notes
        text stop_type
        text status
        timestamptz created_at
        timestamptz updated_at
    }

    service_passengers {
        uuid id PK
        uuid company_id FK
        uuid service_id FK
        uuid service_stop_id FK
        uuid passenger_id FK
        uuid route_passenger_id FK
        text seat_code
        timestamptz boarded_at
        uuid marked_by_driver_id FK
        uuid marked_by_profile_id FK
        text notes
        text attendance_status
        timestamptz created_at
        timestamptz updated_at
    }

    service_locations {
        uuid id PK
        uuid company_id FK
        uuid service_id FK
        uuid driver_id FK
        uuid vehicle_id FK
        numeric latitude
        numeric longitude
        numeric speed_kmh
        numeric heading
        numeric accuracy_meters
        timestamptz recorded_at
        timestamptz created_at
    }

    service_events {
        uuid id PK
        uuid company_id FK
        uuid service_id FK
        text actor_type
        uuid actor_id
        text event_type
        jsonb payload
        timestamptz created_at
    }

    incident_types {
        uuid id PK
        uuid company_id FK
        text name
        text category
        text_array source_allowed
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    incidents {
        uuid id PK
        uuid company_id FK
        text incident_code
        uuid service_id FK
        uuid route_id FK
        uuid vehicle_id FK
        uuid driver_id FK
        uuid passenger_id FK
        uuid service_stop_id FK
        uuid incident_type_id FK
        text reported_by_type
        uuid reported_by_profile_id FK
        uuid reported_by_driver_id FK
        uuid reported_by_passenger_id FK
        text title
        text description
        numeric latitude
        numeric longitude
        text_array photo_urls
        text severity
        text status
        timestamptz occurred_at
        timestamptz reported_at
        timestamptz resolved_at
        text resolution_notes
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    fuel_logs {
        uuid id PK
        uuid company_id FK
        uuid vehicle_id FK
        uuid service_id FK
        uuid driver_id FK
        text station_name
        text fuel_type
        numeric liters
        numeric total_amount
        numeric unit_price
        numeric odometer_km
        integer fuel_level_before_eighths
        integer fuel_level_after_eighths
        text receipt_number
        text receipt_file_url
        text notes
        uuid created_by_profile_id FK
        timestamptz fuel_datetime
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    maintenance_orders {
        uuid id PK
        uuid company_id FK
        uuid vehicle_id FK
        uuid incident_id FK
        text order_code
        text title
        text description
        text workshop_name
        date scheduled_date
        timestamptz started_at
        timestamptz completed_at
        numeric estimated_cost
        numeric final_cost
        numeric odometer_km
        uuid created_by_profile_id FK
        text maintenance_type
        text priority
        text status
        jsonb checklist
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    operational_alerts {
        uuid id PK
        uuid company_id FK
        text alert_type
        text title
        text description
        text entity_type
        uuid entity_id
        text severity
        text status
        timestamptz resolved_at
        timestamptz deleted_at
        timestamptz created_at
        timestamptz updated_at
    }

    passenger_service_access {
        uuid id PK
        uuid company_id FK
        uuid service_id FK
        uuid passenger_id FK
        uuid service_passenger_id FK
        text access_code
        timestamptz expires_at
        timestamptz used_at
        text status
        timestamptz created_at
        timestamptz updated_at
    }

    contract_passengers {
        uuid id PK
        uuid company_id FK
        uuid contract_id FK
        uuid passenger_id FK
        timestamptz deleted_at
        timestamptz created_at
    }

    audit_logs {
        uuid id PK
        uuid company_id FK
        text actor_type
        uuid actor_id
        text action
        text entity_type
        uuid entity_id
        jsonb before_data
        jsonb after_data
        timestamptz created_at
    }

    schema_migrations {
        text filename PK
        timestamptz applied_at
    }
