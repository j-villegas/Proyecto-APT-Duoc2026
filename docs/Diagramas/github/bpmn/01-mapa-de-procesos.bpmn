<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_bpmn00-mapa-de-procesos" targetNamespace="http://trazza.cl/bpmn">
  <bpmn:collaboration id="Collab_bpmn00-mapa-de-procesos">
    <bpmn:participant id="Part_dir" name="Dirección" processRef="Proc_dir" />
    <bpmn:participant id="Part_core" name="Operación de transporte" processRef="Proc_core" />
    <bpmn:participant id="Part_cont" name="Continuidad operacional" processRef="Proc_cont" />
    <bpmn:participant id="Part_sop" name="Soporte" processRef="Proc_sop" />
    <bpmn:messageFlow id="Msg_bpmn00-mapa-de-procesos_0" sourceRef="d_t1" targetRef="o_s" name="Objetivos y contratos" />
    <bpmn:messageFlow id="Msg_bpmn00-mapa-de-procesos_1" sourceRef="o_e" targetRef="d_w" name="Indicadores" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_dir" isExecutable="false">
    <bpmn:startEvent id="d_s" name="Metas del servicio" />
    <bpmn:task id="d_t1" name="Definir objetivos de servicio y contratos" />
    <bpmn:intermediateCatchEvent id="d_w" name="Indicadores recibidos"><bpmn:messageEventDefinition id="d_w_d" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="d_t2" name="Revisar indicadores" />
    <bpmn:endEvent id="d_e" name="Ciclo revisado" />
    <bpmn:sequenceFlow id="Flow_dir_0" sourceRef="d_s" targetRef="d_t1" />
    <bpmn:sequenceFlow id="Flow_dir_1" sourceRef="d_t1" targetRef="d_w" />
    <bpmn:sequenceFlow id="Flow_dir_2" sourceRef="d_w" targetRef="d_t2" />
    <bpmn:sequenceFlow id="Flow_dir_3" sourceRef="d_t2" targetRef="d_e" />
  </bpmn:process>
  <bpmn:process id="Proc_core" isExecutable="false">
    <bpmn:startEvent id="o_s" name="Objetivos recibidos"><bpmn:messageEventDefinition id="o_s_d" /></bpmn:startEvent>
    <bpmn:subProcess id="o_1" name="Contratar y registrar pasajeros" />
    <bpmn:subProcess id="o_2" name="Planificar rutas y servicios" />
    <bpmn:subProcess id="o_3" name="Ejecutar y supervisar viajes" />
    <bpmn:subProcess id="o_4" name="Evaluar cumplimiento" />
    <bpmn:endEvent id="o_e" name="Indicadores enviados"><bpmn:messageEventDefinition id="o_e_d" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_core_0" sourceRef="o_s" targetRef="o_1" />
    <bpmn:sequenceFlow id="Flow_core_1" sourceRef="o_1" targetRef="o_2" />
    <bpmn:sequenceFlow id="Flow_core_2" sourceRef="o_2" targetRef="o_3" />
    <bpmn:sequenceFlow id="Flow_core_3" sourceRef="o_3" targetRef="o_4" />
    <bpmn:sequenceFlow id="Flow_core_4" sourceRef="o_4" targetRef="o_e" />
  </bpmn:process>
  <bpmn:process id="Proc_cont" isExecutable="false">
    <bpmn:subProcess id="c_1" name="Mantener flota" />
    <bpmn:subProcess id="c_2" name="Controlar combustible" />
    <bpmn:subProcess id="c_3" name="Gestionar incidentes" />
  </bpmn:process>
  <bpmn:process id="Proc_sop" isExecutable="false">
    <bpmn:subProcess id="s_1" name="Identidad y acceso, aislamiento por empresa, datos e historial operacional" />
  </bpmn:process>
