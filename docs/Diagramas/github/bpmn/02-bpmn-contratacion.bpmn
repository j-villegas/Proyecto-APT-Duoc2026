<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_bpmn01-contratacion-y-pasajeros" targetNamespace="http://trazza.cl/bpmn">
  <bpmn:collaboration id="Collab_bpmn01-contratacion-y-pasajeros">
    <bpmn:participant id="Part_cli" name="Cliente contratante" processRef="Proc_cli" />
    <bpmn:participant id="Part_pyme" name="Pyme de transporte (Administración operacional)" processRef="Proc_pyme" />
    <bpmn:participant id="Part_sis" name="TRAZZA / sistema" processRef="Proc_sis" />
    <bpmn:messageFlow id="Msg_bpmn01-contratacion-y-pasajeros_0" sourceRef="c_t1" targetRef="p_s" name="Solicitud" />
    <bpmn:messageFlow id="Msg_bpmn01-contratacion-y-pasajeros_1" sourceRef="p_t2" targetRef="c_w" name="Condiciones" />
    <bpmn:messageFlow id="Msg_bpmn01-contratacion-y-pasajeros_2" sourceRef="c_e" targetRef="p_w" name="Aceptación" />
    <bpmn:messageFlow id="Msg_bpmn01-contratacion-y-pasajeros_3" sourceRef="p_e" targetRef="s_s" name="Tras aceptación" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_cli" isExecutable="false">
    <bpmn:startEvent id="c_s" name="Necesidad de transporte" />
    <bpmn:task id="c_t1" name="Comunicar necesidad" />
    <bpmn:intermediateCatchEvent id="c_w" name="Condiciones recibidas"><bpmn:messageEventDefinition id="c_w_d" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="c_t2" name="Confirmar condiciones" />
    <bpmn:endEvent id="c_e" name="Aceptación enviada"><bpmn:messageEventDefinition id="c_e_d" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_cli_0" sourceRef="c_s" targetRef="c_t1" />
    <bpmn:sequenceFlow id="Flow_cli_1" sourceRef="c_t1" targetRef="c_w" />
    <bpmn:sequenceFlow id="Flow_cli_2" sourceRef="c_w" targetRef="c_t2" />
    <bpmn:sequenceFlow id="Flow_cli_3" sourceRef="c_t2" targetRef="c_e" />
  </bpmn:process>
  <bpmn:process id="Proc_pyme" isExecutable="false">
    <bpmn:startEvent id="p_s" name="Solicitud recibida"><bpmn:messageEventDefinition id="p_s_d" /></bpmn:startEvent>
    <bpmn:task id="p_t1" name="Revisar antecedentes" />
    <bpmn:exclusiveGateway id="p_g" name="¿Antecedentes completos?" />
    <bpmn:task id="p_t2" name="Acordar condiciones" />
    <bpmn:intermediateCatchEvent id="p_w" name="Aceptación recibida"><bpmn:messageEventDefinition id="p_w_d" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="p_e" name="Contrato aceptado"><bpmn:messageEventDefinition id="p_e_d" /></bpmn:endEvent>
    <bpmn:task id="p_t3" name="Solicitar corrección" />
    <bpmn:sequenceFlow id="Flow_pyme_0" sourceRef="p_s" targetRef="p_t1" />
    <bpmn:sequenceFlow id="Flow_pyme_1" sourceRef="p_t1" targetRef="p_g" />
    <bpmn:sequenceFlow id="Flow_pyme_2" sourceRef="p_g" targetRef="p_t2" name="Completos" />
    <bpmn:sequenceFlow id="Flow_pyme_3" sourceRef="p_g" targetRef="p_t3" name="Incompletos" />
    <bpmn:sequenceFlow id="Flow_pyme_4" sourceRef="p_t3" targetRef="p_t1" name="Datos corregidos" />
    <bpmn:sequenceFlow id="Flow_pyme_5" sourceRef="p_t2" targetRef="p_w" />
    <bpmn:sequenceFlow id="Flow_pyme_6" sourceRef="p_w" targetRef="p_e" />
  </bpmn:process>
  <bpmn:process id="Proc_sis" isExecutable="false">
    <bpmn:startEvent id="s_s" name="Contrato aceptado"><bpmn:messageEventDefinition id="s_s_d" /></bpmn:startEvent>
    <bpmn:task id="s_t1" name="Registrar contrato" />
    <bpmn:task id="s_t2" name="Registrar pasajeros del contrato" />
    <bpmn:endEvent id="s_e" name="Contrato habilitado" />
    <bpmn:sequenceFlow id="Flow_sis_0" sourceRef="s_s" targetRef="s_t1" />
    <bpmn:sequenceFlow id="Flow_sis_1" sourceRef="s_t1" targetRef="s_t2" />
    <bpmn:sequenceFlow id="Flow_sis_2" sourceRef="s_t2" targetRef="s_e" />
  </bpmn:process>
