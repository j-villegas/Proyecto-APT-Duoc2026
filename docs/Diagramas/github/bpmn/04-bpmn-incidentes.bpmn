<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_bpmn03-reportar-y-resolver-incidentes" targetNamespace="http://trazza.cl/bpmn">
  <bpmn:collaboration id="Collab_bpmn03-reportar-y-resolver-incidentes">
    <bpmn:participant id="Part_con" name="Conductor / app nativa" processRef="Proc_con" />
    <bpmn:participant id="Part_pyme" name="Pyme de transporte (Administración operacional)" processRef="Proc_pyme" />
    <bpmn:participant id="Part_sis" name="TRAZZA / sistema" processRef="Proc_sis" />
    <bpmn:messageFlow id="Msg_bpmn03-reportar-y-resolver-incidentes_0" sourceRef="c_t1" targetRef="p_s" name="Reporte" />
    <bpmn:messageFlow id="Msg_bpmn03-reportar-y-resolver-incidentes_1" sourceRef="p_t3" targetRef="c_w" name="Indicaciones" />
    <bpmn:messageFlow id="Msg_bpmn03-reportar-y-resolver-incidentes_2" sourceRef="p_e2" targetRef="s_s" name="Derivación" />
    <bpmn:messageFlow id="Msg_bpmn03-reportar-y-resolver-incidentes_3" sourceRef="p_e1" targetRef="s_t2" name="Resolución" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_con" isExecutable="false">
    <bpmn:startEvent id="c_s" name="Incidente en el servicio" />
    <bpmn:task id="c_t1" name="Reportar incidente" />
    <bpmn:intermediateCatchEvent id="c_w" name="Indicaciones recibidas"><bpmn:messageEventDefinition id="c_w_d" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="c_t2" name="Recibir indicaciones" />
    <bpmn:endEvent id="c_e" name="Conductor informado" />
    <bpmn:sequenceFlow id="Flow_con_0" sourceRef="c_s" targetRef="c_t1" />
    <bpmn:sequenceFlow id="Flow_con_1" sourceRef="c_t1" targetRef="c_w" />
    <bpmn:sequenceFlow id="Flow_con_2" sourceRef="c_w" targetRef="c_t2" />
    <bpmn:sequenceFlow id="Flow_con_3" sourceRef="c_t2" targetRef="c_e" />
  </bpmn:process>
  <bpmn:process id="Proc_pyme" isExecutable="false">
    <bpmn:startEvent id="p_s" name="Reporte recibido"><bpmn:messageEventDefinition id="p_s_d" /></bpmn:startEvent>
    <bpmn:task id="p_t1" name="Registrar y clasificar" />
    <bpmn:task id="p_t2" name="Evaluar impacto" />
    <bpmn:exclusiveGateway id="p_g" name="¿Severidad?" />
    <bpmn:task id="p_t3" name="Coordinar contingencia" />
    <bpmn:endEvent id="p_e1" name="Contingencia coordinada"><bpmn:messageEventDefinition id="p_e1_d" /></bpmn:endEvent>
    <bpmn:endEvent id="p_e2" name="Atención solicitada"><bpmn:messageEventDefinition id="p_e2_d" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_pyme_0" sourceRef="p_s" targetRef="p_t1" />
    <bpmn:sequenceFlow id="Flow_pyme_1" sourceRef="p_t1" targetRef="p_t2" />
    <bpmn:sequenceFlow id="Flow_pyme_2" sourceRef="p_t2" targetRef="p_g" />
    <bpmn:sequenceFlow id="Flow_pyme_3" sourceRef="p_g" targetRef="p_t3" name="Crítico / alto" />
    <bpmn:sequenceFlow id="Flow_pyme_4" sourceRef="p_g" targetRef="p_e2" name="Bajo / medio" />
    <bpmn:sequenceFlow id="Flow_pyme_5" sourceRef="p_t3" targetRef="p_e1" />
  </bpmn:process>
  <bpmn:process id="Proc_sis" isExecutable="false">
    <bpmn:startEvent id="s_s" name="Atención solicitada"><bpmn:messageEventDefinition id="s_s_d" /></bpmn:startEvent>
    <bpmn:task id="s_t1" name="Gestionar atención" />
    <bpmn:task id="s_t2" name="Registrar resolución" />
    <bpmn:endEvent id="s_e" name="Incidente resuelto" />
    <bpmn:sequenceFlow id="Flow_sis_0" sourceRef="s_s" targetRef="s_t1" />
    <bpmn:sequenceFlow id="Flow_sis_1" sourceRef="s_t1" targetRef="s_t2" />
    <bpmn:sequenceFlow id="Flow_sis_2" sourceRef="s_t2" targetRef="s_e" />
  </bpmn:process>
